PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list is fine
CLIENT_URL=http://localhost:3000
# Public URL of this server (used for the GitHub OAuth callback)
SERVER_URL=http://localhost:5000
# Create at github.com/settings/developers -> New OAuth App
# Callback URL: <SERVER_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# BetterAuth signing secret (falls back to JWT_SECRET if empty). Use 32+ random chars
BETTER_AUTH_SECRET=
# Google login (optional). console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: <SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
